FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ネットワーク系の標準コマンドを一通り導入
RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 \
        iputils-ping \
        iputils-tracepath \
        traceroute \
        wget \
        curl \
        dnsutils \
        netcat-openbsd \
        net-tools \
        nmap \
        ca-certificates \
        iputils-arping \
        vim-tiny \
        less \
        procps \
    && rm -rf /var/lib/apt/lists/*

# コンテナを常駐させる
CMD ["sleep", "infinity"]

arsenal/Dockerfile

FROM httpd:2.4

# WebDAV 用のロック DB 置き場・共有用ディレクトリ・認証ファイルを用意
RUN set -eux; \
    mkdir -p /usr/local/apache2/auth /usr/local/apache2/var /dav/noauth /dav/auth; \
    htpasswd -bc /usr/local/apache2/auth/.htpasswd user password; \
    chown -R daemon:daemon /usr/local/apache2/var

# WebDAV 設定を追加し、メイン設定から include
COPY httpd-dav.conf /usr/local/apache2/conf/extra/httpd-dav.conf
RUN printf '\nInclude conf/extra/httpd-dav.conf\n' >> /usr/local/apache2/conf/httpd.conf


arsenal/httpd-dav.conf

# ===== Arsenal WebDAV 設定 =====
# httpd:2.4 の既定 httpd.conf で未ロードのモジュールだけを追加ロード
<IfModule !dav_module>
    LoadModule dav_module modules/mod_dav.so
</IfModule>
<IfModule !dav_fs_module>
    LoadModule dav_fs_module modules/mod_dav_fs.so
</IfModule>

# WebDAV ロックデータベース
DavLockDB /usr/local/apache2/var/DavLock

# ---- noauth 共有: 認証なしでアクセス可 ----
Alias /noauth /dav/noauth
<Directory /dav/noauth>
    Dav On
    Options Indexes
    AllowOverride None
    Require all granted
</Directory>

# ---- auth 共有: Basic 認証 (user / password) ----
Alias /auth /dav/auth
<Directory /dav/auth>
    Dav On
    Options Indexes
    AllowOverride None
    AuthType Basic
    AuthName "Arsenal Authenticated Share"
    AuthUserFile /usr/local/apache2/auth/.htpasswd
    Require valid-user
</Directory>



