cat > /tmp/relay.py <<'EOF'
import socket, threading, sys
lport=int(sys.argv[1]); thost=sys.argv[2]; tport=int(sys.argv[3])
def pipe(a,b):
    try:
        while True:
            d=a.recv(65536)
            if not d: break
            b.sendall(d)
    except Exception: pass
    try: b.shutdown(socket.SHUT_WR)
    except Exception: pass
s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
s.bind(("0.0.0.0",lport)); s.listen(16)
print("relay :%d -> %s:%d"%(lport,thost,tport),flush=True)
while True:
    c,_=s.accept()
    try: u=socket.create_connection((thost,tport))
    except Exception: c.close(); continue
    threading.Thread(target=pipe,args=(c,u),daemon=True).start()
    threading.Thread(target=pipe,args=(u,c),daemon=True).start()
EOF

LIBINJ=$(find / -name 'lib_inject.so' 2>/dev/null | head -1)
LD_PRELOAD="$LIBINJ" python3 /tmp/relay.py 8080 127.0.0.1 80 &

